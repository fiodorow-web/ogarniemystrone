---
// Wspólny układ każdej podstrony: <head> z meta i SEO, nagłówek, <main>, stopka.
// Nazwa pliku strony = adres (src/pages/oferta.astro → /oferta) = <body data-page="oferta">.
import '../styles/styles.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, SCHEMA_HOME } from '../site.js';
import fontBricolage from '../assets/fonts/bricolage-grotesque.woff2?url';
import fontFraunces from '../assets/fonts/fraunces-italic.woff2?url';
import fontOnest from '../assets/fonts/onest.woff2?url';
import appJs from '../scripts/app.js?url';

interface Props {
  title: string;
  description: string;
  /** Nazwa w okruszkach JSON-LD (BreadcrumbList). */
  breadcrumb?: string;
  ogTitle?: string;
  /** 'home': dane strukturalne ProfessionalService. */
  schema?: 'home';
  /** false: bez sekcji „Napisz. Resztę ogarniemy my.” */
  footCta?: boolean;
  /** false: strona nie używa Fraunces, więc go nie wczytujemy z wyprzedzeniem. */
  preloadSerif?: boolean;
  /** false: noindex, bez canonical i bez sitemap. */
  index?: boolean;
}
const { title, description, breadcrumb, ogTitle, schema, footCta = true, preloadSerif = true, index = true } = Astro.props;

const slug = Astro.url.pathname.replace(/^\/|\.html$|\/$/g, '') || 'index';
const isPage = slug !== '404' && index;
const urlPath = slug === 'index' ? '/' : `/${slug}`;
const url = isPage ? SITE.domain + urlPath : null;
const current = isPage ? urlPath : null;
const breadcrumbLd = !schema && breadcrumb && url ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: `${SITE.domain}/` },
    { '@type': 'ListItem', position: 2, name: breadcrumb, item: url },
  ],
}) : null;
---
<!doctype html>
<html lang="pl" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
{url ? <><link rel="canonical" href={url}>
<meta name="robots" content="index, follow"></> : <meta name="robots" content="noindex">}
<meta name="author" content={SITE.author}>
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content={SITE.themeLight} media="(prefers-color-scheme: light)">
<meta name="theme-color" content={SITE.themeDark} media="(prefers-color-scheme: dark)">
<meta property="og:type" content="website">
<meta property="og:locale" content="pl_PL">
<meta property="og:site_name" content={SITE.name}>
<meta property="og:title" content={ogTitle || title}>
<meta property="og:description" content={description}>
{url && <meta property="og:url" content={url}>}
<meta property="og:image" content={`${SITE.domain}/og.png`}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={SITE.ogImageAlt}>
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preload" href={fontBricolage} as="font" type="font/woff2" crossorigin>
{preloadSerif && <link rel="preload" href={fontFraunces} as="font" type="font/woff2" crossorigin>}
<link rel="preload" href={fontOnest} as="font" type="font/woff2" crossorigin>
<script is:inline>(function(){var d=document.documentElement;d.className=d.className.replace('no-js','js');try{var t=localStorage.getItem('os-motyw');if(t==='dark'||t==='light')d.setAttribute('data-theme',t);}catch(e){}})();</script>
<script is:inline src={appJs} defer></script>
{schema === 'home' && <script is:inline type="application/ld+json" set:html={JSON.stringify(SCHEMA_HOME, null, 2)} />}
{breadcrumbLd && <script is:inline type="application/ld+json" set:html={breadcrumbLd} />}
</head>
<body data-page={slug}>

<Header current={current} />
<main id="tresc" tabindex="-1">
<slot />
</main>

<Footer current={current} cta={footCta} />
<script>
  // Statystyki odwiedzin bez ciasteczek (Vercel Web Analytics). Skrypt ładuje się z tej samej domeny (/_vercel/insights/)
  // i liczy wejście po adresie z paska (/oferta), a nie po pliku (/oferta.html), więc bez komponentu @vercel/analytics/astro.
  import { inject } from '@vercel/analytics';
  inject({ framework: 'astro', basePath: import.meta.env.PUBLIC_VERCEL_OBSERVABILITY_BASEPATH }, import.meta.env.PUBLIC_VERCEL_OBSERVABILITY_CLIENT_CONFIG);
</script>
</body>
</html>
