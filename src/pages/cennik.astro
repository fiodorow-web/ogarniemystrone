---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Crumbs from '../components/Crumbs.astro';
import Loop from '../components/Loop.astro';
import Arrow from '../components/Arrow.astro';
---
<Base
  title="Cennik – Ogarniemy Stronę"
  description="Strony od 999 zł. Najpierw projekt, potem płatność. Dobierz pakiet w 20 sekund: wizytówka, firma albo firma z rezerwacjami online."
  breadcrumb="Cennik"
>
  <header class="wrap page-head">
    <Crumbs name="Cennik" />
    <h1 id="h-cennik" class="page-title">Ile kosztuje <span class="loopw">strona?<Loop class="lp lp-enter" hidden /></span></h1>
    <p class="lead">Strony od 999&nbsp;zł. Cena zależy od liczby podstron i&nbsp;tego, czego potrzebujesz – dokładną kwotę podamy po krótkiej, bezpłatnej rozmowie.</p>
  </header>

  <section class="sec sec-tight" aria-label="Pakiety">
    <div class="wrap pkgs">
      <article class="pkg rv" data-pkg="rezerwacje">
        <Loop class="pkg-lp" hidden />
        <span class="pkg-match">Pasuje do Ciebie</span>
        <h2 class="pkg-h">Firma z&nbsp;rezerwacjami</h2>
        <p class="pkg-d">Klient zarezerwuje termin bez dzwonienia.</p>
        <p class="pkg-p"><span>od</span> [CENA]&nbsp;zł</p>
        <ul class="ticks">
          <li>Wszystko z&nbsp;pakietu Firma</li>
          <li>Rezerwacje online przez system, z&nbsp;którego już korzystasz</li>
          <li>[Zakres do ustalenia]</li>
        </ul>
        <a class="btn btn-s" href="/kontakt" data-pkg-ask="Firma z rezerwacjami">Zapytaj o&nbsp;ten pakiet</a>
      </article>
      <article class="pkg pkg-hl rv rv2" data-pkg="firma">
        <Loop class="pkg-lp" hidden />
        <span class="pkg-match">Pasuje do Ciebie</span>
        <span class="pkg-tag">Polecamy na start</span>
        <h2 class="pkg-h">Firma</h2>
        <p class="pkg-d">Kilka podstron, które zmienisz bez naszej pomocy.</p>
        <p class="pkg-p"><span>od</span> [CENA]&nbsp;zł</p>
        <ul class="ticks">
          <li>O&nbsp;nas, oferta, cennik i&nbsp;kontakt na osobnych podstronach</li>
          <li>Godziny i&nbsp;cennik zmienisz bez dzwonienia do nas</li>
          <li>Kopie zapasowe robimy my</li>
        </ul>
        <a class="btn btn-p" href="/kontakt" data-pkg-ask="Firma">Zapytaj o&nbsp;ten pakiet</a>
      </article>
      <article class="pkg rv rv3" data-pkg="wizytowka">
        <Loop class="pkg-lp" hidden />
        <span class="pkg-match">Pasuje do Ciebie</span>
        <h2 class="pkg-h">Wizytówka</h2>
        <p class="pkg-d">Jedna strona z&nbsp;tym, czego szuka klient.</p>
        <p class="pkg-p"><span>od</span> 999&nbsp;zł</p>
        <ul class="ticks">
          <li>O&nbsp;firmie, oferta, godziny i&nbsp;dojazd na jednej stronie</li>
          <li>Wygodna na telefonie</li>
          <li>Łatwiej Cię znaleźć w&nbsp;Mapach Google</li>
        </ul>
        <a class="btn btn-s" href="/kontakt" data-pkg-ask="Wizytówka">Zapytaj o&nbsp;ten pakiet</a>
      </article>
    </div>
    <div class="wrap pay rv">
      <h2 class="pay-h">Najpierw projekt, <em class="ac">potem</em> płatność</h2>
      <ol class="pay-steps">
        <li><b>0&nbsp;zł</b><span>Rozmowa i&nbsp;wycena</span></li>
        <li><b>50%</b><span>Po akceptacji projektu</span></li>
        <li><b>50%</b><span>Po zrobieniu strony</span></li>
      </ol>
    </div>
  </section>

  <section class="sec sec-alt" id="konfigurator" aria-labelledby="h-konf">
    <div class="wrap konf">
      <div class="sec-head rv">
        <p class="casual">Dobra, wiesz już, o&nbsp;co chodzi.</p>
        <h2 id="h-konf" class="h2 kin">Dobierz pakiet w&nbsp;<em class="ac">20 sekund</em></h2>
        <p class="lead">Trzy pytania. Podświetlimy pakiet, który pasuje, i&nbsp;przygotujemy wiadomość do nas.</p>
      </div>
      <form class="konf-form" data-konf novalidate>
        <fieldset class="q rv">
          <legend><span class="q-n">1</span>Ile podstron potrzebujesz?</legend>
          <div class="opts">
            <label class="opt"><input type="radio" name="q1" value="jedna"><span><b>Jedna wystarczy</b><small>Wszystko na jednej stronie</small></span></label>
            <label class="opt"><input type="radio" name="q1" value="kilka"><span><b>Kilka</b><small>O&nbsp;firmie, oferta, kontakt…</small></span></label>
          </div>
        </fieldset>
        <fieldset class="q rv rv2">
          <legend><span class="q-n">2</span>Klienci mają rezerwować terminy online?</legend>
          <div class="opts">
            <label class="opt"><input type="radio" name="q2" value="tak"><span><b>Tak</b><small>Bez dzwonienia</small></span></label>
            <label class="opt"><input type="radio" name="q2" value="nie"><span><b>Nie</b><small>Wystarczy kontakt</small></span></label>
          </div>
        </fieldset>
        <fieldset class="q rv rv3">
          <legend><span class="q-n">3</span>Chcesz sam zmieniać godziny i&nbsp;cennik?</legend>
          <div class="opts">
            <label class="opt"><input type="radio" name="q3" value="tak"><span><b>Tak</b><small>Zmieniam sam</small></span></label>
            <label class="opt"><input type="radio" name="q3" value="nie"><span><b>Nie trzeba</b><small>Rzadko coś się zmienia</small></span></label>
          </div>
        </fieldset>
      </form>
      <div class="konf-out" aria-live="polite" data-konf-out>
        <div class="konf-empty" data-konf-empty>
          <span class="konf-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <p data-konf-progress>Odpowiedz na trzy pytania, a&nbsp;podświetlimy pasujący pakiet.</p>
        </div>
        <div class="konf-res" hidden data-konf-res>
          <p class="konf-k">Pasuje Ci pakiet</p>
          <p class="konf-name" data-konf-name>Firma</p>
          <p class="konf-price" data-konf-price>od [CENA] zł</p>
          <p class="konf-why" data-konf-why></p>
          <div class="cta-row">
            <button class="btn btn-p mag" type="button" data-konf-send>Wyślij zapytanie z&nbsp;tym zakresem<Arrow /></button>
            <button class="link-btn" type="button" data-konf-reset>Zacznij od nowa</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="h-faq">
    <div class="wrap faq-wrap">
      <h2 id="h-faq" class="h2 kin rv">Pytania</h2>
      <div class="faq" data-faq>
        <Faq q="Od czego zależy cena?">Od liczby podstron i&nbsp;dodatków, takich jak rezerwacje online czy aktualności. Dokładną kwotę podamy po krótkiej rozmowie.</Faq>
        <Faq q="Jak wygląda płatność?">Najpierw przygotowujemy projekt strony. Po jego akceptacji płacisz połowę kwoty. Drugą połowę płacisz po zrobieniu strony na podstawie tego projektu. Rozmowa i&nbsp;wycena są bezpłatne.</Faq>
        <Faq q="Ile trwa przygotowanie strony?">[Czas realizacji – do uzupełnienia].</Faq>
        <Faq q="Dla kogo robicie strony?">Dla małych firm, specjalistów i&nbsp;osób, które prowadzą własną działalność – z&nbsp;różnych branż.</Faq>
        <Faq q="Czy zmienię godziny i&nbsp;cennik bez Waszej pomocy?">Tak. Godziny otwarcia, cennik i&nbsp;aktualności zmienisz bez dzwonienia do nas.</Faq>
        <Faq q="Kto dba o&nbsp;to, żeby strona działała?">My. Strona działa i&nbsp;jest bezpieczna, a&nbsp;kopie zapasowe robimy my.</Faq>
        <Faq q="Czy działacie tylko w&nbsp;Białymstoku?">Nie. Jesteśmy z&nbsp;Białegostoku, ale strony robimy dla firm w&nbsp;całej Polsce.</Faq>
        <Faq q="Co, jeśli projekt mi się nie spodoba?">Wprowadzamy poprawki, zanim zaczniemy robić stronę. Pierwszą połowę płacisz dopiero po akceptacji projektu.</Faq>
      </div>
    </div>
  </section>
</Base>
