---
import Base from '../layouts/Base.astro';
import Loop from '../components/Loop.astro';
---
<Base
  title="Nie ma takiej strony – Ogarniemy Stronę"
  description="Ups, tej strony nie ogarnęliśmy."
  index={false}
>
  <div class="wrap lost">
    <p class="lost-n" aria-hidden="true"><span class="loopw">404<Loop class="lp lp-enter lp-messy" /></span></p>
    <h1 id="h-404" class="page-title">Ups, tej strony nie <em class="ac">ogarnęliśmy</em>.</h1>
    <p class="lead">Może link się zestarzał albo wkradła się literówka. Zdarza się najlepszym.</p>
    <div class="cta-row">
      <a class="btn btn-p" href="/">Wróć na start</a>
      <a class="btn btn-s" href="/oferta">Zobacz ofertę</a>
      <a class="more" href="/kontakt">Napisz do nas</a>
    </div>
  </div>
</Base>
