---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import { SITE, LD_ID, LD_FIRMA } from '../../site.js';
import { twarde, twardeHtml } from '../../../tools/twarde-spacje.mjs';

// Wpis z src/content/blog/{slug}.md pod adresem /blog/{slug}.
export async function getStaticPaths() {
  const wpisy = await getCollection('blog');
  return wpisy.map((wpis) => ({ params: { slug: wpis.id }, props: { wpis } }));
}
const { wpis } = Astro.props;
// Treść wpisu jako gotowy HTML z Markdowna, z twardymi spacjami (tools/twarde-spacje.mjs)
// Tabele w kontenerze przewijanym w bok, do którego da się wejść klawiaturą (WCAG 2.1.1)
const tresc = twardeHtml(wpis.rendered?.html ?? '')
  .replace(/<table>/g, '<div class="table-scroll" tabindex="0" role="region" aria-label="Tabela, przewiń w bok, jeśli się nie mieści"><table>')
  .replace(/<\/table>/g, '</table></div>');
const w = wpis.data;
const dataPL = (d: Date) => new Intl.DateTimeFormat('pl-PL', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Warsaw' }).format(d);
const iso = (d: Date) => d.toISOString().slice(0, 10);
// Czas czytania: ok. 200 słów na minutę
const minuty = Math.max(1, Math.round((wpis.body ?? '').split(/\s+/).length / 200));
const inne = (await getCollection('blog')).filter((x) => x.id !== wpis.id).sort((a, b) => b.data.data.getTime() - a.data.data.getTime()).slice(0, 2);

const url = `${SITE.domain}/blog/${wpis.id}`;
// Okładka 1200 × 630 w JPG: og:image i obraz w BlogPosting
const og = w.okladka ? await getImage({ src: w.okladka, width: 1200, height: 630, format: 'jpg' }) : null;
const ogImage = og ? { url: SITE.domain + og.src, alt: w.okladkaAlt ?? w.tytul } : undefined;
// Autorzy i firma przez te same @id co na stronie głównej i w O nas (src/site.js)
const AUTORZY = [[LD_ID.mateusz, 'Mateusz Fiodorow'], [LD_ID.sebastian, 'Sebastian Herman']].map(([id, name]) => ({ '@type': 'Person', '@id': id, name, url: `${SITE.domain}/o-nas` }));
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: w.tytul,
  description: w.opis,
  datePublished: iso(w.data),
  dateModified: iso(w.aktualizacja ?? w.data),
  inLanguage: 'pl-PL',
  mainEntityOfPage: url,
  image: ogImage?.url ?? `${SITE.domain}/og.png`,
  author: AUTORZY,
  publisher: LD_FIRMA,
  isPartOf: { '@id': LD_ID.witryna },
};
---
<Base
  title={`${w.tytul} – Ogarniemy Stronę`}
  description={w.opis}
  breadcrumb={w.tytul}
  breadcrumbParent={{ name: 'Blog', path: '/blog' }}
  ld={ld}
  ogImage={ogImage}
  article={{ published: iso(w.data), modified: iso(w.aktualizacja ?? w.data) }}
>
  <article>
    <header class="wrap page-head">
      <Crumbs name={w.tytul} parent={{ name: 'Blog', path: '/blog' }} />
      <h1 class="post-title">{twarde(w.tytul)}</h1>
      <p class="lead">{twarde(w.zajawka)}</p>
      <p class="post-meta"><a href="/o-nas">Mateusz Fiodorow i&nbsp;Sebastian Herman</a><span aria-hidden="true">·</span><time datetime={iso(w.data)}>{dataPL(w.data)}</time>{w.aktualizacja && <Fragment><span aria-hidden="true">·</span><span>aktualizacja: <time datetime={iso(w.aktualizacja)}>{dataPL(w.aktualizacja)}</time></span></Fragment>}<span aria-hidden="true">·</span><span>{minuty} min czytania</span></p>
    </header>
    <div class="wrap post-body">
{w.okladka && (
      <figure class="post-cover">
        <Picture src={w.okladka} formats={['avif']} fallbackFormat="webp" widths={[480, 800, 1200]} sizes="(max-width: 900px) 92vw, 68ch" alt={w.okladkaAlt ?? ''} loading="eager" fetchpriority="high" />
        {w.okladkaAutor && <figcaption>Zdjęcie: {w.okladkaLink ? <a href={w.okladkaLink} rel="noopener">{w.okladkaAutor}</a> : w.okladkaAutor}, licencja CC0.</figcaption>}
      </figure>
)}
      <div class="post-text">
        <Fragment set:html={tresc} />
      </div>
      <aside class="post-authors" aria-label="O autorach">
        <p><b>O autorach.</b> Mateusz Fiodorow i&nbsp;Sebastian Herman robią strony internetowe dla małych firm i&nbsp;specjalistów z&nbsp;całej Polski. Piszemy prosto i&nbsp;tylko o&nbsp;tym, co sprawdzamy w&nbsp;źródłach. <a href="/o-nas">Poznaj nas</a> albo <a href="/kontakt">napisz do nas</a>.</p>
      </aside>
    </div>
  </article>

{inne.length > 0 && (
  <section class="sec sec-alt" aria-labelledby="h-dalej">
    <div class="wrap">
      <h2 id="h-dalej" class="h2 h2-s kin rv">Czytaj dalej</h2>
      <ul class="posts posts-more">
{inne.map((x, i) => <PostCard wpis={x} h="h3" class={['rv', 'rv rv2'][i % 2]} />)}
      </ul>
    </div>
  </section>
)}
</Base>
