---
// Tu trafia formularz wysłany bez JavaScriptu (api/kontakt.js przekierowuje po udanej wysyłce).
// Z JavaScriptem podziękowanie pokazuje się w miejscu formularza na /kontakt.
import Base from '../layouts/Base.astro';
import Loop from '../components/Loop.astro';
---
<Base
  title="Dziękujemy – Ogarniemy Stronę"
  description="Wiadomość dotarła. Odpiszemy do 24 h."
  index={false}
  footCta={false}
>
  <div class="wrap lost">
    <div class="sent">
      <p class="sent-k"><span class="loopw">Dotarło<Loop class="lp lp-sent" hidden /></span></p>
      <h1 id="h-dzieki" class="sent-h">Dziękujemy.</h1>
      <p class="lead">Odpiszemy do 24&nbsp;h, żeby umówić termin rozmowy.</p>
      <div class="cta-row">
        <a class="btn btn-p" href="/">Wróć na start</a>
        <a class="more" href="/realizacje">Zobacz nasze realizacje</a>
      </div>
    </div>
  </div>
</Base>
