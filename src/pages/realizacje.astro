---
import Base from '../layouts/Base.astro';
---
<Base
  title="Realizacje – Ogarniemy Stronę"
  description="Strony, które zrobiliśmy dla małych firm i specjalistów. Każdą pokazujemy na telefonie i laptopie."
  breadcrumb="Realizacje"
>
  <header class="wrap page-head">
    <nav class="crumbs" aria-label="Ścieżka"><a href="/">Start</a><span aria-hidden="true">/</span><span aria-current="page">Realizacje</span></nav>
    <h1 id="h-real" class="page-title">Nasze <span class="loopw">realizacje<svg class="lp lp-enter" viewBox="0 0 200 80" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path pathLength="1" d="M152 7C108 2 44 4 18 20C2 31 8 60 54 72C100 80 170 74 192 54C202 40 190 16 142 9C124 7 110 9 100 13"/></svg></span></h1>
    <p class="lead">Każdą stronę pokazujemy tak, jak widzą ją klienci: na telefonie i&nbsp;laptopie.</p>
  </header>

  <section class="sec sec-tight" aria-label="Lista realizacji">
    <div class="wrap">
      <div class="chips" role="group" aria-label="Filtruj realizacje" data-filter>
        <button class="chip" type="button" aria-pressed="true" data-f="all">Wszystkie <span class="chip-n">3</span></button>
        <button class="chip" type="button" aria-pressed="false" data-f="wizytowka">Wizytówki <span class="chip-n">2</span></button>
        <button class="chip" type="button" aria-pressed="false" data-f="podstrony">Kilka podstron <span class="chip-n">1</span></button>
        <button class="chip" type="button" aria-pressed="false" data-f="rezerwacje">Z&nbsp;rezerwacjami <span class="chip-n">0</span></button>
      </div>
      <p class="sr-only" role="status" data-filter-status></p>
      <div class="works" data-works>
        <a class="work rv" href="/kontakt" data-cat="wizytowka">
          <span class="thumb" aria-hidden="true"><span class="th-win"><i></i><i></i><i></i></span><span class="th-l w60"></span><span class="th-l w40"></span><span class="th-btn"></span><span class="th-label">[Zdjęcie realizacji]</span></span>
          <span class="work-meta"><span class="work-t">[Nazwa firmy]</span><span class="work-s">[Miasto] · [branża] · wizytówka</span></span>
        </a>
        <a class="work rv rv2" href="/kontakt" data-cat="podstrony">
          <span class="thumb th-alt" aria-hidden="true"><span class="th-win"><i></i><i></i><i></i></span><span class="th-l w70"></span><span class="th-l w50"></span><span class="th-btn"></span><span class="th-label">[Zdjęcie realizacji]</span></span>
          <span class="work-meta"><span class="work-t">[Nazwa firmy]</span><span class="work-s">[Miasto] · [branża] · kilka podstron</span></span>
        </a>
        <a class="work rv rv3" href="/kontakt" data-cat="wizytowka">
          <span class="thumb th-alt2" aria-hidden="true"><span class="th-win"><i></i><i></i><i></i></span><span class="th-l w50"></span><span class="th-l w70"></span><span class="th-btn"></span><span class="th-label">[Zdjęcie realizacji]</span></span>
          <span class="work-meta"><span class="work-t">[Nazwa firmy]</span><span class="work-s">[Miasto] · [branża] · wizytówka</span></span>
        </a>
      </div>
      <div class="empty" hidden data-empty>
        <svg class="empty-ill" viewBox="0 0 160 120" aria-hidden="true" focusable="false"><rect x="34" y="40" width="92" height="62" rx="10"/><path d="M34 52h92"/><path class="empty-lp" pathLength="1" d="M122 30C92 18 40 20 22 44 10 62 22 98 64 108 104 116 150 104 152 74 154 52 138 34 108 30"/></svg>
        <h2 class="empty-h">Tu jeszcze pusto.</h2>
        <p>Pierwsza strona z&nbsp;rezerwacjami online może być Twoja.</p>
        <a class="btn btn-s" href="/kontakt">Umów rozmowę</a>
      </div>
    </div>
  </section>
</Base>
