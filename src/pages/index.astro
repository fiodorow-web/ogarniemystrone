---
import Base from '../layouts/Base.astro';
import PriceFrom from '../components/PriceFrom.astro';
import Assure from '../components/Assure.astro';
import Faq from '../components/Faq.astro';
import Loop from '../components/Loop.astro';
import Arrow from '../components/Arrow.astro';
---
<Base
  title="Ogarniemy Stronę – strony internetowe dla małych firm"
  description="Nowoczesne strony internetowe dla małych firm i specjalistów z całej Polski. Projekt, treści, start i opieka po starcie. Strony od 999 zł."
  ogTitle="Ty robisz swoje, my ogarniemy stronę"
  schema="home"
>

  <div class="wrap hero">
    <div class="hero-copy">
      <p class="badge"><span class="dot" aria-hidden="true"></span>Przyjmujemy nowe projekty</p>
      <h1 id="h-start" class="mega">
        <span class="sr-only">Ty robisz swoje, my ogarniemy stronę.</span>
        <span class="mega-vis" aria-hidden="true" data-kinetic>
          <span class="ln">Ty robisz swoje,</span>
          <span class="ln">my <em class="ac" data-soft>ogarniemy</em></span>
          <span class="ln"><span class="loopw">stronę.<Loop class="lp lp-hero" /></span></span>
        </span>
      </h1>
      <p class="lead hero-lead">Nowoczesne strony internetowe dla małych firm i&nbsp;specjalistów z&nbsp;całej Polski. Projekt, treści, start i&nbsp;opieka po starcie – od&nbsp;999&nbsp;zł.</p>
      <div class="cta-row" data-hero-cta>
        <a class="btn btn-p mag" href="/kontakt">Umów rozmowę<Arrow /></a>
        <a class="btn btn-s" href="/cennik#konfigurator">Dobierz pakiet</a>
      </div>
      <Assure />
    </div>

    <div class="mess-wrap">
      <ul class="mess" data-mess aria-label="Typowy bałagan na stronach małych firm i to, jak go ogarniamy">
        <li class="stk tape" style="--i:0"><span class="stk-tag"><span class="tg-p">przed</span><span class="tg-s">ogarnięte</span></span><span class="stk-face"><span class="p">Strona z&nbsp;2014 roku</span><span class="sr-only"> – po ogarnięciu: </span><span class="s">Wygląda na dziś</span></span></li>
        <li class="stk" style="--i:1"><span class="stk-tag"><span class="tg-p">przed</span><span class="tg-s">ogarnięte</span></span><span class="stk-face"><span class="p">Nie działa na telefonie</span><span class="sr-only"> – po ogarnięciu: </span><span class="s">Wygodna na każdym telefonie</span></span></li>
        <li class="stk" style="--i:2"><span class="stk-tag"><span class="tg-p">przed</span><span class="tg-s">ogarnięte</span></span><span class="stk-face"><span class="p">Cennik w&nbsp;PDF-ie</span><span class="sr-only"> – po ogarnięciu: </span><span class="s">Cennik na stronie, zmieniasz sam</span></span></li>
        <li class="stk tape" style="--i:3"><span class="stk-tag"><span class="tg-p">przed</span><span class="tg-s">ogarnięte</span></span><span class="stk-face"><span class="p">Godziny tylko na Facebooku</span><span class="sr-only"> – po ogarnięciu: </span><span class="s">Godziny i&nbsp;dojazd w&nbsp;jednym miejscu</span></span></li>
        <li class="stk" style="--i:4"><span class="stk-tag"><span class="tg-p">przed</span><span class="tg-s">ogarnięte</span></span><span class="stk-face"><span class="p">Formularz ląduje w&nbsp;spamie</span><span class="sr-only"> – po ogarnięciu: </span><span class="s">Wiadomości prosto na Twój <span class="nw">e-mail</span></span></span></li>
        <li class="stk tape" style="--i:5"><span class="stk-tag"><span class="tg-p">przed</span><span class="tg-s">ogarnięte</span></span><span class="stk-face"><span class="p">W&nbsp;Google Cię nie ma</span><span class="sr-only"> – po ogarnięciu: </span><span class="s">Łatwiej Cię znaleźć w&nbsp;Google</span></span></li>
      </ul>
      <button class="btn btn-s mess-btn" type="button" data-mess-btn aria-pressed="false">
        <span class="mess-ico" aria-hidden="true"><Loop /><svg class="mess-mini" viewBox="0 0 24 10" focusable="false"><rect x=".5" y="2.5" width="6.5" height="5" rx="1"/><rect x="8.75" y="2.5" width="6.5" height="5" rx="1"/><rect x="17" y="2.5" width="6.5" height="5" rx="1"/></svg></span>
        <span data-mess-label>Ogarnij ten bałagan</span>
      </button>
    </div>
  </div>

  <section class="sec sec-bento" aria-labelledby="h-bento">
    <div class="wrap">
      <div class="sec-head rv">
        <p class="kicker">W&nbsp;każdej stronie</p>
        <h2 id="h-bento" class="h2 kin">Klikaj śmiało, <em class="ac">to działa</em></h2>
        <p class="lead">Tak zachowuje się strona, którą dostaniesz. Pobaw się kafelkami.</p>
      </div>
      <div class="bento" data-car tabindex="0" role="region" aria-label="Co dostajesz w każdej stronie">
        <article class="tile t1 c-lime rv">
          <span class="vlabel" aria-hidden="true">01 · telefon</span>
          <div class="tile-txt">
            <h3 class="tile-h">Wygodna na telefonie</h3>
            <p>Numer, dojazd i&nbsp;formularz są pod kciukiem. Tekst czyta się bez powiększania.</p>
            <button class="link-btn" type="button" data-ph-btn>Zadzwoń na próbę</button>
          </div>
          <div class="phone" aria-hidden="true" data-par="-0.05">
            <div class="ph-screen" data-ph>
              <div class="ph-bar"><b>Twoja Firma</b><i></i></div>
              <div class="ph-hero"><span>Zapraszamy</span><b>Dobra robota, blisko Ciebie</b></div>
              <div class="ph-acts"><span class="ph-act ph-call" data-ph-call>Zadzwoń</span><span class="ph-act">Dojazd</span><span class="ph-act">Napisz</span></div>
              <p class="ph-open" data-ph-open><i></i><span data-ph-open-txt>Otwarte · do 16:00</span></p>
              <div class="ph-row"><span>pn–pt</span><span>8:00–16:00</span></div>
              <div class="ph-row"><span>sobota</span><span>9:00–13:00</span></div>
              <div class="ph-map"><svg class="ph-route" viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false"><path pathLength="1" d="M18 82V62H40V44H57"/></svg><span class="ph-me"></span><span class="ph-pin"></span></div>
              <div class="ph-dial"><span class="ph-av">TF</span><b>Twoja Firma</b><span data-ph-time>Łączenie…</span><span class="ph-end"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg></span></div>
            </div>
          </div>
        </article>
        <article class="tile t2 c-ink rv">
          <span class="vlabel" aria-hidden="true">02 · google</span>
          <h3 class="tile-h">Łatwiej Cię znaleźć</h3>
          <div class="search" aria-hidden="true">
            <div class="s-box"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" focusable="false"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg><span class="s-typed" data-typer="fryzjer białystok|księgowa warszawa|mechanik siedlce|kwiaciarnia gdańsk">fryzjer białystok</span><span class="caret"></span></div>
            <div class="s-res s-you"><b>Twoja Firma</b><span>strona · godziny · dojazd</span></div>
            <div class="s-res s-dim"><span class="bar w70"></span><span class="bar w40"></span></div>
          </div>
          <p>W&nbsp;Google i&nbsp;w&nbsp;Mapach Google, tam gdzie szukają klienci.</p>
        </article>
        <article class="tile t3 c-mint rv">
          <span class="vlabel" aria-hidden="true">03 · zmiany</span>
          <h3 class="tile-h">Zmieniasz sam</h3>
          <div class="hours" data-hours>
            <div class="hr"><span>pn–pt</span><b data-h1>8:00–16:00</b></div>
            <div class="hr"><span>sobota</span><b data-h2>9:00–13:00</b></div>
            <button class="btn btn-s btn-sm" type="button" data-hours-btn>Zmień godziny</button>
          </div>
          <p>Godziny, cennik i&nbsp;aktualności – bez dzwonienia do nas.</p>
        </article>
        <article class="tile t5 rv">
          <span class="vlabel" aria-hidden="true">04 · szybkość</span>
          <h3 class="tile-h">Szybka nawet w&nbsp;terenie</h3>
          <div class="speed" aria-hidden="true" data-speed>
            <span class="sig"><i></i><i></i><i></i><i></i></span>
            <span class="load"><i></i></span>
            <span class="load-txt">Gotowe</span>
          </div>
          <p>Dbamy o&nbsp;optymalizację strony i&nbsp;każdego zdjęcia, więc otwiera się szybko nawet przy słabym zasięgu.</p>
          <button class="link-btn" type="button" data-speed-btn>Sprawdź jeszcze raz</button>
        </article>
        <article class="tile t6 pattern rv">
          <span class="vlabel" aria-hidden="true">05 · spokój</span>
          <h3 class="tile-h">Kopie zapasowe robimy&nbsp;my</h3>
          <div class="backups" aria-hidden="true"><span>Kopia · dziś</span><span>Kopia · wczoraj</span><span>Kopia · 2 dni temu</span></div>
          <p>Strona działa i&nbsp;jest bezpieczna. Ty nawet o&nbsp;tym nie myślisz.</p>
        </article>
      </div>
      <div class="car-ctrl" data-car-ctrl>
        <button class="round-btn" type="button" data-car-prev aria-label="Poprzedni kafelek"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m15 18-6-6 6-6"/></svg></button>
        <span class="car-count" aria-live="polite" data-car-count>1 / 5</span>
        <button class="round-btn" type="button" data-car-next aria-label="Następny kafelek"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6"/></svg></button>
      </div>
    </div>
  </section>


  <section class="sec sec-say" aria-label="Nasza rola">
    <div class="wrap">
      <p class="say" data-words>Ty skupiasz się na swojej pracy. My <em class="ac">ogarniemy</em> stronę – od projektu, przez treści, po kopie zapasowe.</p>
    </div>
  </section>

  <section class="sec sec-steps" aria-labelledby="h-steps">
    <div class="wrap">
      <div class="sec-head rv">
        <p class="kicker">Jak pracujemy</p>
        <h2 id="h-steps" class="h2 kin">Cztery kroki, <em class="ac">zero</em> niespodzianek</h2>
      </div>
      <div class="steps-wrap" data-steps>
        <svg class="steps-line" viewBox="0 0 1000 120" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path pathLength="1" d="M10 70C120 20 200 110 330 62S520 18 640 66 860 104 990 40"/></svg>
        <ol class="steps4">
          <li class="rv"><span class="st-n">01<Loop class="lp" hidden /></span><h3>Rozmowa</h3><p>Krótko o&nbsp;Twojej firmie i&nbsp;o&nbsp;tym, co ma się znaleźć na stronie.</p></li>
          <li class="rv rv2"><span class="st-n">02<Loop class="lp" hidden /></span><h3>Projekt</h3><p>Pokazujemy projekt na telefonie i&nbsp;komputerze. Poprawki wprowadzamy przed startem.</p></li>
          <li class="rv rv3"><span class="st-n">03<Loop class="lp" hidden /></span><h3>Treści</h3><p>Teksty piszemy my. Przed publikacją zatwierdzasz je mailem.</p></li>
          <li class="rv rv4"><span class="st-n">04<Loop class="lp" hidden /></span><h3>Start i&nbsp;opieka</h3><p>Strona startuje pod Twoim adresem, a&nbsp;my zostajemy po starcie.</p></li>
        </ol>
      </div>
      <a class="more rv" href="/jak-pracujemy">Zobacz, jak to wygląda krok po kroku<Arrow /></a>
    </div>
  </section>

  <PriceFrom id="h-price">
    <Fragment slot="casual">Strona już od</Fragment>
    <p slot="side">Projektujemy nowoczesne strony zgodne ze standardami 2026 roku. Mają przemyślany układ (UX), w&nbsp;którym klient szybko znajduje to, czego szuka, a&nbsp;treści przygotowujemy pod wyszukiwarkę Google (SEO). Rozmowa i&nbsp;wycena są bezpłatne.</p>
  </PriceFrom>

  <section class="sec" aria-labelledby="h-faq-start">
    <div class="wrap faq-wrap">
      <div class="sec-head rv">
        <p class="kicker">Zanim napiszesz</p>
        <h2 id="h-faq-start" class="h2 kin">Częste <em class="ac">pytania</em></h2>
        <a class="more" href="/cennik">Więcej o&nbsp;cenach<Arrow /></a>
      </div>
      <div class="faq" data-faq>
        <Faq q="Co, jeśli projekt mi się nie spodoba?">Wprowadzamy poprawki, zanim zaczniemy robić stronę. Pierwszą połowę płacisz dopiero po akceptacji projektu.</Faq>
        <Faq q="Czy muszę znać się na stronach?">Nie. Teksty piszemy my na podstawie rozmowy, a&nbsp;Ty zatwierdzasz je mailem. Godziny i&nbsp;cennik zmienisz później bez naszej pomocy.</Faq>
        <Faq q="Czy działacie w&nbsp;całej Polsce?">Tak. Pracujemy zdalnie: rozmawiamy przez telefon albo online, więc odległość nie ma znaczenia.</Faq>
        <Faq q="Co się dzieje po starcie strony?">Zostajemy z&nbsp;Tobą. Pilnujemy, żeby strona działała, i&nbsp;robimy kopie zapasowe.</Faq>
      </div>
    </div>
  </section>
</Base>
