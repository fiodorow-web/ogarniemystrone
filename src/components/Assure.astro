---
// Zapewnienia przy głównym CTA (SPRZEDAZ.md, zasada 7). Brzmienie zatwierdzone, nie zmieniać.
// form: wersja pod przyciskiem formularza (dwa zapewnienia, odpowiedź na początku).
interface Props {
  form?: boolean;
}
const { form = false } = Astro.props;
---
{form ? (
<ul class="assure assure-form">
  <li>Odpowiedź do 24&nbsp;h w&nbsp;dni robocze</li>
  <li>Bezpłatna rozmowa i&nbsp;wycena</li>
</ul>
) : (
<ul class="assure">
  <li>Bezpłatna rozmowa i&nbsp;wycena</li>
  <li>Najpierw projekt, potem płatność</li>
  <li>Odpowiedź do 24&nbsp;h w&nbsp;dni robocze</li>
</ul>
)}
