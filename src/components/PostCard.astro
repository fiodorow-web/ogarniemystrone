---
// Kafel wpisu na liście bloga i w „Czytaj dalej” pod wpisem. Cały kafel jest linkiem.
import Arrow from './Arrow.astro';
import { twarde } from '../../tools/twarde-spacje.mjs';
import type { CollectionEntry } from 'astro:content';

interface Props {
  wpis: CollectionEntry<'blog'>;
  class?: string;
  /** Poziom nagłówka: h2 na liście bloga, h3 pod wpisem. */
  h?: 'h2' | 'h3';
}
const { wpis, class: cls = '', h: H = 'h2' } = Astro.props;
const { tytul, zajawka, data } = wpis.data;
const dataPL = new Intl.DateTimeFormat('pl-PL', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Warsaw' }).format(data);
---
<li class={`post-card ${cls}`}>
  <a href={`/blog/${wpis.id}`}>
    <time datetime={data.toISOString().slice(0, 10)}>{dataPL}</time>
    <H class="post-card-t">{twarde(tytul)}</H>
    <p>{twarde(zajawka)}</p>
    <span class="more" aria-hidden="true">Czytaj<Arrow /></span>
  </a>
</li>
