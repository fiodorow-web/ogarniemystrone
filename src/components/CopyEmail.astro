---
// Przycisk kopiujący adres e-mail (app.js: [data-copy]).
import { SITE } from '../site.js';

interface Props {
  inv?: boolean;
}
const { inv = false } = Astro.props;
---
<button class={inv ? 'copy copy-inv' : 'copy'} type="button" data-copy={SITE.email}><span>{SITE.email}</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg><span class="sr-only">– skopiuj adres</span></button>
