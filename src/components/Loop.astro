---
// Pętla marki (brandbook, sekcja 2). Rysuje się przez stroke-dashoffset (pathLength="1").
// hidden: dodaje aria-hidden="true" (gdy pętla nie siedzi już w elemencie ukrytym dla czytników).
interface Props {
  class?: string;
  hidden?: boolean;
}
const { class: cls, hidden = false } = Astro.props;
---
<svg class={cls} viewBox="0 0 200 80" preserveAspectRatio="none" aria-hidden={hidden ? 'true' : undefined} focusable="false"><path pathLength="1" d="M152 7C108 2 44 4 18 20C2 31 8 60 54 72C100 80 170 74 192 54C202 40 190 16 142 9C124 7 110 9 100 13"/></svg>
